# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# RAGProbe outputs. Baselines ARE committed (they are the regression contract);
# per-run reports are not.
reports/*
# ...except the reply caches and run files behind the published numbers. Without
# them "every number here reproduces" is only true on the machine that ran it.
# They hold model replies, not prompts and not keys.
!reports/bench_cache_2048/
!reports/bench_cache_4096/
!reports/final_v1_*.json
!reports/final_v2_*.json
!reports/final_analysis.json
# Cached neural embeddings (pure function of model + corpus; rebuilt on demand)
.ragprobe/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Secrets - never commit an API key
.env
/site/

# Local tooling
.claude/
